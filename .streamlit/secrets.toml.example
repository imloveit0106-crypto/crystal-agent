# Streamlit Cloud用の環境変数設定例
#
# Streamlit Cloudにデプロイする場合：
# 1. 「Advanced settings」→「Secrets」を開く
# 2. 以下の内容をコピー
# 3. あなたの実際のAPIキーとデータベースIDに置き換えて貼り付け

GEMINI_API_KEY = "your_gemini_api_key_here"
NOTION_API_KEY = "your_notion_api_key_here"
NOTION_USER_PROFILE_DB_ID = "your_user_profile_database_id_here"
NOTION_LIFE_LOG_DB_ID = "your_life_log_database_id_here"

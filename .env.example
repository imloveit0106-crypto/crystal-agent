# =====================================================
# Crystal Agent - 環境変数設定ファイル
# =====================================================
# このファイルを ".env" という名前でコピーして使用してください
# コマンド: cp .env.example .env

# -----------------------------------------------------
# Gemini API Key
# -----------------------------------------------------
# 取得方法: https://aistudio.google.com/api-keys
# 1. Google AI Studio にアクセス
# 2. 「APIキーを作成」をクリック
# 3. 生成されたキーをコピーして下に貼り付け
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------
# Notion API Key
# -----------------------------------------------------
# 取得方法: https://www.notion.so/my-integrations
# 1. 「+ New integration」をクリック
# 2. 名前を「Crystal Agent」にして作成
# 3. 「Internal Integration Token」をコピーして下に貼り付け
NOTION_API_KEY=your_notion_api_key_here

# -----------------------------------------------------
# Notion データベース ID
# -----------------------------------------------------
# 取得方法:
# 1. Notionでデータベースを開く
# 2. URLから32文字のIDを取得
#    例: https://notion.so/xxxxx?v=yyyyy
#    この場合、"xxxxx" の部分がデータベースID

# User Profile データベース（あなたの基本情報）
NOTION_USER_PROFILE_DB_ID=your_user_profile_database_id_here

# Life Log データベース（日々の行動ログ）
NOTION_LIFE_LOG_DB_ID=your_life_log_database_id_here
